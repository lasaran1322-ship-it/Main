*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet Packages
*.nupkg
*.snupkg

# Entity Framework
*.db
*.db-shm
*.db-wal
Migrations/

# Local user files
appsettings.Development.json
appsettings.local.json

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.local
.env.*.local
